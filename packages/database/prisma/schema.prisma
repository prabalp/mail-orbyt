// Mail Orbyt database schema.
//
// This file grows one phase at a time. Phase 0 established the toolchain;
// Phase 2 added authentication, multi-tenancy, invitations, and audit
// logging; Phase 3 added lead import, companies, lead lists, and the
// suppression foundation; Phase 4 adds deterministic research/enrichment.
//
// Implemented so far (Phases 0-4): FeatureFlag, User, Account, Session,
// VerificationToken, PasswordResetToken, EmailVerificationToken,
// Organisation, OrganisationMembership, Invitation, AuditEvent, DataSource,
// Company, Lead, LeadCompany, LeadList, LeadListMembership, ImportBatch,
// ImportRow, SuppressionEntry, ResearchJob, ResearchProviderRun,
// ResearchSource, ResearchDocument, ResearchFact, ResearchFactEvidence,
// ResearchSnapshot.
//
// Remaining model list target (see docs/architecture.md): Campaign,
// CampaignLead, SequenceStep, EmailDraft, EmailGeneration, InboxConnection,
// OAuthCredential, InboxSettings, SendingDomain, DomainAuthenticationCheck,
// ScheduledEmail, OutboxMessage, SentEmail, EmailEvent, Conversation, Reply,
// Meeting, MeetingOutcome, AttributionRecord, RetargetTask, JobFailure.
//
// Post-Phase-12 addition: McpOAuthClient, McpAuthorizationCode,
// McpAccessToken, McpRefreshToken — the OAuth 2.1 authorization server
// backing the remote MCP connector (apps/mcp-server).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Operational kill switches (e.g. organisation-wide emergency sending stop).
/// Introduced in Phase 0 because the architecture test and worker bootstrap
/// both need a real table to prove migrations work end-to-end.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ---------------------------------------------------------------------------
// Authentication (Auth.js adapter models + our own credential fields)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  /// Null for users who only ever sign in via Google login (no local password).
  passwordHash      String?
  /// Bumped whenever the password changes. Sessions use JWT (required
  /// because the Credentials provider cannot use adapter-persisted database
  /// sessions), so this is how a password reset forces existing sessions to
  /// be treated as invalid — the JWT callback compares its embedded value
  /// against this column on every request.
  passwordChangedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  memberships             OrganisationMembership[]
  sentInvitations         Invitation[]             @relation("InvitedBy")
  auditEvents             AuditEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mcpAuthorizationCodes   McpAuthorizationCode[]
  mcpAccessTokens         McpAccessToken[]
  mcpRefreshTokens        McpRefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Auth.js adapter model — one row per linked OAuth provider (Google login).
/// Distinct from Gmail sending credentials (packages/gmail, Phase 6): this
/// table is ONLY ever used for application sign-in tokens.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by Auth.js's PrismaAdapter type contract even though this
/// product uses Credentials + Google OAuth (no email magic-link provider).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organisation {
  id   String @id @default(cuid())
  name String
  slug String @unique
  /// The organisation's DEFAULT campaign prompt: which recipient data emails
  /// may use, how they are formatted, and the voice to write in. Used by
  /// campaigns that set no prompt of their own (Campaign.emailPromptInstructions
  /// replaces it outright). Sent as the leading section of the user message,
  /// never merged into the system prompt, so it can never relax the safety
  /// rules there. Null falls back to DEFAULT_CAMPAIGN_EMAIL_PROMPT. See
  /// docs/ai-boundaries.md.
  emailPromptInstructions String? @db.Text
  /// Booking link embedded verbatim (via deterministic substitution, never
  /// model-generated) into every AI-drafted email's call to action.
  calendlyUrl             String?
  /// Full override of the safety-rule system prompts, editable in Settings.
  /// Null means "use the package default" (see DEFAULT_GENERATION_SYSTEM_PROMPT
  /// / DEFAULT_REVIEW_SYSTEM_PROMPT in packages/email-generation/src/prompt.ts).
  /// These hold only rules no campaign may relax — what an email says and how
  /// it looks comes from the campaign prompt instead.
  generationSystemPrompt String? @db.Text
  reviewSystemPrompt     String? @db.Text
  /// The organisation's own AI provider (Gemini) API key, AES-256-GCM
  /// encrypted at rest with TOKEN_ENCRYPTION_KEY — the same scheme used for
  /// Gmail OAuth tokens. Null means "use the deployment's AI_PROVIDER_API_KEY".
  /// Never returned to the browser once saved; the settings API exposes only a
  /// masked hint. Applies to every AI call made for this organisation: email
  /// generation, the QA review pass, and AI keyword extraction.
  aiProviderApiKey String? @db.Text
  /// Model ID used for this organisation's AI calls. Null means "use the
  /// deployment's AI_PROVIDER_MODEL". Independent of aiProviderApiKey — an
  /// organisation may pin a model without bringing its own key.
  aiProviderModel  String?

  memberships        OrganisationMembership[]
  invitations        Invitation[]
  auditEvents        AuditEvent[]
  leads              Lead[]
  companies          Company[]
  leadLists          LeadList[]
  importBatches      ImportBatch[]
  suppressionEntries SuppressionEntry[]
  researchJobs       ResearchJob[]
  researchSources    ResearchSource[]
  researchFacts      ResearchFact[]
  researchSnapshots  ResearchSnapshot[]
  researchKeywordRuns ResearchKeywordRun[]
  emailDrafts        EmailDraft[]
  inboxes            Inbox[]
  signatures         Signature[]
  domainDnsChecks    DomainDnsCheck[]
  campaigns          Campaign[]
  outboxItems        OutboxItem[]
  conversations      Conversation[]
  meetings           Meeting[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpAccessTokens       McpAccessToken[]
  mcpRefreshTokens      McpRefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id              String           @id @default(cuid())
  organisationId  String
  email           String
  role            OrganisationRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

enum AuditEventType {
  LOGIN
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
  ORGANISATION_CREATED
  INBOX_CONNECTED
  CAMPAIGN_LAUNCHED
  CAMPAIGN_PAUSED
  SUPPRESSION_CREATED
  SUPPRESSION_REMOVED
  DATA_EXPORTED
  DATA_DELETED
  MCP_CLIENT_REGISTERED
  MCP_AUTHORIZED
  MCP_TOKEN_REFRESHED
  MCP_TOKEN_REVOKED
  MCP_TOOL_INVOKED
}

model AuditEvent {
  id             String         @id @default(cuid())
  organisationId String?
  userId         String?
  type           AuditEventType
  /// Non-sensitive structured context only (e.g. { targetUserId, role }).
  /// Never store tokens, passwords, or full email content here.
  metadata       Json?

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// MCP remote connector — OAuth 2.1 authorization server (public clients,
// PKCE-only, no client secret). Tokens are opaque, hashed at rest (SHA-256
// via packages/authentication's hashToken), following the same
// generate-raw-return-once, store-only-the-hash pattern as Invitation and
// PasswordResetToken above. scope is a space-separated list of Permission
// strings (see packages/authentication/src/permissions.ts) plus the bare
// "profile" scope for membership-only routes.
// ---------------------------------------------------------------------------

/// A client application registered via Dynamic Client Registration (e.g.
/// claude.ai's remote MCP connector). Public client only: no client secret
/// is stored, since the authorization-code exchange is secured by PKCE.
model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String
  redirectUris String[]

  authorizationCodes McpAuthorizationCode[]
  accessTokens       McpAccessToken[]
  refreshTokens      McpRefreshToken[]

  createdAt DateTime @default(now())
}

/// Single-use, short-lived (~60s) code issued after the user approves the
/// consent screen. codeChallenge/codeChallengeMethod implement PKCE (S256);
/// consumedAt prevents replay.
model McpAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  userId              String
  organisationId      String
  scope               String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  consumedAt          DateTime?

  client       McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([organisationId])
}

/// A bearer token accepted both by apps/web's REST API (in place of a
/// session cookie) and by apps/mcp-server's /mcp endpoint. Bound to exactly
/// one organisation — a token never grants cross-organisation access even
/// if the user belongs to several.
model McpAccessToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  clientId       String
  userId         String
  organisationId String
  scope          String
  expiresAt      DateTime
  revokedAt      DateTime?

  client       McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([organisationId])
  @@index([expiresAt])
}

/// Long-lived (~90d), rotated on every use: refreshAccessToken issues a new
/// row and sets replacedByTokenHash on this one rather than mutating it in
/// place, so reuse of an already-rotated refresh token is detectable.
model McpRefreshToken {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  clientId            String
  userId              String
  organisationId      String
  scope               String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  client       McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Leads, companies, and import (Phase 3)
// ---------------------------------------------------------------------------

enum LeadStatus {
  ACTIVE
  ARCHIVED
}

/// Registry of where a field's value came from. Referenced by key (not a
/// hard FK) from Lead.fieldSources / Company.fieldSources so provenance can
/// be recorded without a join for every field on every write. Expanded in
/// Phase 4 when research providers become real DataSource rows.
enum DataSourceKind {
  MANUAL
  CSV_IMPORT
  RESEARCH_PROVIDER
}

model DataSource {
  id    String         @id @default(cuid())
  key   String         @unique
  label String
  kind  DataSourceKind

  createdAt DateTime @default(now())

  @@index([kind])
}

model Company {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  domain         String?
  industry       String?
  websiteUrl     String?
  city           String?
  state          String?
  country        String?
  /// Per-field provenance: { [fieldName]: { source: DataSourceKind, updatedAt: ISO string } }
  fieldSources   Json?

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leads         Lead[]
  leadCompanies LeadCompany[]
  researchJobs    ResearchJob[]
  researchSources ResearchSource[]
  researchFacts   ResearchFact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, domain])
  @@index([organisationId])
  @@index([organisationId, name])
}

model Lead {
  id             String     @id @default(cuid())
  organisationId String
  firstName      String?
  lastName       String?
  email          String?
  title          String?
  linkedinUrl    String?
  websiteUrl     String?
  industry       String?
  city           String?
  state          String?
  country        String?
  status         LeadStatus @default(ACTIVE)
  companyId      String?
  /// Per-field provenance, same shape as Company.fieldSources.
  fieldSources   Json?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  leadCompanies       LeadCompany[]
  leadListMemberships LeadListMembership[]
  importRows          ImportRow[]
  researchJobs        ResearchJob[]
  researchSources     ResearchSource[]
  researchFacts       ResearchFact[]
  emailDrafts         EmailDraft[]
  campaignEnrollments CampaignEnrollment[]
  outboxItems         OutboxItem[]
  conversations       Conversation[]
  meetings            Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partial-unique-like behavior: Postgres treats NULLs as distinct, so
  // multiple leads with a NULL email are allowed — only non-null emails are
  // deduplicated within an organisation, which is the intended behavior
  // (duplicate detection only applies when there's an email to compare).
  @@unique([organisationId, email])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, companyId])
}

/// Many-to-many lead/company association beyond the lead's single "current
/// company" FK — e.g. a previous employer surfaced during research (Phase
/// 4). isCurrent mirrors Lead.companyId for the one row where they match.
model LeadCompany {
  id        String  @id @default(cuid())
  leadId    String
  companyId String
  title     String?
  isCurrent Boolean @default(false)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([leadId, companyId])
  @@index([leadId])
  @@index([companyId])
}

/// A named set of leads. Every CSV import creates (or reuses) one, so a
/// campaign can enroll "the leads from that import" as a unit instead of the
/// operator ticking prospects one at a time.
model LeadList {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  description    String?

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships   LeadListMembership[]
  importBatches ImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId])
}

model LeadListMembership {
  id         String @id @default(cuid())
  leadListId String
  leadId     String

  leadList LeadList @relation(fields: [leadListId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([leadListId, leadId])
  @@index([leadListId])
  @@index([leadId])
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DuplicateStrategy {
  SKIP
  UPDATE_BLANKS
  OVERWRITE
  REJECT
  ALLOW_SEPARATE
}

model ImportBatch {
  id                String            @id @default(cuid())
  organisationId    String
  createdByUserId   String
  /// Every import names its leads: the LeadList each imported/updated row is
  /// added to. Required at the API layer (the column is nullable only so
  /// pre-existing batches survive the migration).
  leadListId        String?
  fileName          String
  /// Object storage key for the originally uploaded CSV (see packages/storage).
  storageKey        String
  columnMapping     Json
  duplicateStrategy DuplicateStrategy
  status            ImportBatchStatus @default(PENDING)
  totalRows         Int               @default(0)
  importedCount     Int               @default(0)
  skippedCount      Int               @default(0)
  errorCount        Int               @default(0)
  errorMessage      String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  leadList     LeadList?    @relation(fields: [leadListId], references: [id], onDelete: SetNull)
  rows         ImportRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([leadListId])
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  UPDATED
  SKIPPED
  ERROR
}

model ImportRow {
  id            String          @id @default(cuid())
  importBatchId String
  rowNumber     Int
  rawData       Json
  status        ImportRowStatus @default(PENDING)
  errorMessage  String?
  leadId        String?

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Enables idempotent reprocessing: a worker retry can upsert on
  // (importBatchId, rowNumber) instead of re-appending duplicate rows.
  @@unique([importBatchId, rowNumber])
  @@index([importBatchId])
  @@index([importBatchId, status])
}

// ---------------------------------------------------------------------------
// Suppression foundation (full safety-rule engine lands in Phase 11)
// ---------------------------------------------------------------------------

enum SuppressionType {
  EMAIL
  DOMAIN
}

enum SuppressionReason {
  HARD_BOUNCE
  UNSUBSCRIBE
  MANUAL_DO_NOT_CONTACT
  INVALID_EMAIL
  CUSTOMER
  ACTIVE_OPPORTUNITY
}

model SuppressionEntry {
  id              String            @id @default(cuid())
  organisationId  String
  type            SuppressionType
  value           String
  reason          SuppressionReason
  createdByUserId String?
  note            String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organisationId, type, value])
  @@index([organisationId])
  @@index([organisationId, type])
}

// ---------------------------------------------------------------------------
// Deterministic research & enrichment (Phase 4)
//
// No model in this section is ever written to by an AI call — see
// docs/ai-boundaries.md. Fact `category` is a validated string (see
// packages/research/src/categories.ts) rather than a Prisma enum: the
// spec's category taxonomy has ~50 entries across person/company facts, and
// application-level validation keeps the prohibited-category blocklist and
// the allow-list in one place instead of split across a migration too.
// ---------------------------------------------------------------------------

enum ResearchSubjectType {
  LEAD
  COMPANY
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ResearchJob {
  id                String              @id @default(cuid())
  organisationId    String
  subjectType       ResearchSubjectType
  leadId            String?
  companyId         String?
  status            ResearchJobStatus   @default(PENDING)
  requestedByUserId String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerRuns ResearchProviderRun[]
  facts        ResearchFact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([leadId])
  @@index([companyId])
}

enum ResearchProviderKind {
  WEBSITE
  SEARCH
  NEWS
  RSS
  ENRICHMENT
}

enum ResearchProviderRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED_NOT_CONFIGURED
}

/// One row per provider invocation within a job — a job fans out to every
/// configured provider (website is always available; search/news/enrichment
/// require an API key and record SKIPPED_NOT_CONFIGURED when absent).
model ResearchProviderRun {
  id            String                    @id @default(cuid())
  researchJobId String
  provider      ResearchProviderKind
  status        ResearchProviderRunStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?

  researchJob ResearchJob      @relation(fields: [researchJobId], references: [id], onDelete: Cascade)
  sources     ResearchSource[]

  createdAt DateTime @default(now())

  @@index([researchJobId])
}

/// A single fetched source for a subject+URL — kept as one continuously
/// updated row across reruns (see findOrCreateResearchSource in
/// research-job-service.ts), not one row per research run. organisationId/
/// subjectType/leadId/companyId are denormalized here (rather than derived
/// by walking providerRun -> researchJob) specifically so this row can
/// outlive, and be looked up independently of, any single job/provider run.
model ResearchSource {
  id             String              @id @default(cuid())
  organisationId String
  subjectType    ResearchSubjectType
  leadId         String?
  companyId      String?
  url            String
  title          String?
  publishedAt    DateTime?
  fetchedAt      DateTime            @default(now())
  httpStatus     Int?
  /// The provider run that most recently fetched/updated this row —
  /// informational only, not an owning parent (see onDelete: SetNull).
  researchProviderRunId String?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerRun  ResearchProviderRun? @relation(fields: [researchProviderRunId], references: [id], onDelete: SetNull)
  document     ResearchDocument?
  pageText     ResearchPageText?
  keywordRuns  ResearchKeywordRun[]

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([leadId])
  @@index([companyId])
  @@index([researchProviderRunId])
  @@index([url])
}

/// The full stripped visible text (scripts/styles removed) of a fetched
/// website source, saved unconditionally whenever the fetch itself succeeds
/// — a deliberate, separate exception to ResearchDocument's "never raw HTML
/// or full page text" rule below, kept isolated to this one model so
/// packages/research-keywords can re-run keyword extraction later without
/// re-fetching the site. See docs/ai-boundaries.md.
model ResearchPageText {
  id               String   @id @default(cuid())
  researchSourceId String   @unique
  text             String   @db.Text
  charCount        Int
  extractedAt      DateTime @default(now())

  researchSource ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)
}

enum KeywordExtractionMode {
  DETERMINISTIC
  AI
}

/// One row per keyword-extraction attempt over a ResearchPageText — decoupled
/// from ResearchJob so extraction can be re-run on demand (auto-chained after
/// a successful website fetch, or manually rerun later) without re-fetching
/// the site. Reuses ResearchProviderRunStatus for its status values.
model ResearchKeywordRun {
  id               String                    @id @default(cuid())
  organisationId   String
  researchSourceId String
  mode             KeywordExtractionMode
  status           ResearchProviderRunStatus @default(PENDING)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  researchSource ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)

  @@index([researchSourceId])
  @@index([organisationId])
}

enum ExtractionMethod {
  JSON_LD
  OPEN_GRAPH
  META_TAG
  REGEX
  STRUCTURED_ENDPOINT
  KEYWORD_FREQUENCY
  AI_KEYWORD
}

/// The deterministically-extracted structured content from one source (never
/// raw HTML or full page text — see ResearchPageText above for the one
/// deliberate exception, and docs/ai-boundaries.md on what is and isn't sent
/// anywhere). One row per source — a rerun overwrites this row's contents
/// rather than creating a new one, so ResearchFact.researchDocumentId always
/// points at the current extraction, not a stale one from an old run.
model ResearchDocument {
  id               String           @id @default(cuid())
  researchSourceId String           @unique
  extractionMethod ExtractionMethod
  /// Structured extracted fields only (e.g. JSON-LD Person/Organization
  /// properties, OG tags) — never raw HTML or full page text.
  extractedData    Json

  source ResearchSource @relation(fields: [researchSourceId], references: [id], onDelete: Cascade)
  facts  ResearchFact[]

  createdAt DateTime @default(now())

  @@index([researchSourceId])
}

enum ResearchFactStatus {
  OBSERVED
  USER_CONFIRMED
  USER_REJECTED
  EXPIRED
  CONFLICTED
}

model ResearchFact {
  id                 String              @id @default(cuid())
  organisationId     String
  subjectType        ResearchSubjectType
  leadId             String?
  companyId          String?
  researchJobId      String?
  researchDocumentId String?
  /// Validated against packages/research's category allow-list at write time.
  category           String
  value              String
  sourceUrl          String
  sourceTitle        String?
  sourcePublishedAt  DateTime?
  observedAt         DateTime            @default(now())
  extractionMethod   ExtractionMethod
  confidence         Float
  /// Short, permitted excerpt only — never full page text. Null when the
  /// source doesn't permit excerpting or none was captured.
  evidenceExcerpt    String?
  freshnessExpiresAt DateTime?
  status             ResearchFactStatus  @default(OBSERVED)

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead             Lead?                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  researchJob      ResearchJob?           @relation(fields: [researchJobId], references: [id], onDelete: SetNull)
  researchDocument ResearchDocument?      @relation(fields: [researchDocumentId], references: [id], onDelete: SetNull)
  evidence         ResearchFactEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([leadId])
  @@index([companyId])
  @@index([organisationId, status])
  @@index([category])
}

/// Supplementary corroborating evidence for a fact, beyond its primary
/// source (recorded directly on ResearchFact). Not every fact has extra
/// evidence rows.
model ResearchFactEvidence {
  id             String  @id @default(cuid())
  researchFactId String
  sourceUrl      String
  excerpt        String?

  researchFact ResearchFact @relation(fields: [researchFactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([researchFactId])
}

/// Point-in-time copy of a subject's USER_CONFIRMED facts, taken when a user
/// finalizes research before generating an email (Phase 5 reads the latest
/// snapshot rather than live-querying facts, so a generation's inputs are
/// reproducible even if facts change afterward). leadId/companyId are
/// intentionally plain columns (not Prisma relations) — a snapshot is
/// archival and outliving the lead/company it was taken from is acceptable.
model ResearchSnapshot {
  id             String              @id @default(cuid())
  organisationId String
  subjectType    ResearchSubjectType
  leadId         String?
  companyId      String?
  /// Array of { factId, category, value, sourceUrl } at snapshot time.
  facts          Json

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  emailDrafts  EmailDraft[]

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([leadId])
  @@index([companyId])
}

enum EmailGenerationType {
  INITIAL
  FOLLOW_UP
  CLOSE_THE_LOOP
}

enum EmailDraftStatus {
  DRAFT
  APPROVED
  DISCARDED
}

/// An AI-generated email draft (Phase 5). Every draft is traceable to the
/// exact ResearchSnapshot of facts it was generated from — the AI is never
/// given live, unbounded access to a lead/company's facts, and a draft's
/// inputs remain reproducible even if facts are edited or deleted later. A
/// a regeneration or an experiment variant points back at
/// the draft it was derived from via basedOnDraftId rather than duplicating
/// the snapshot, since a regeneration must not introduce new factual claims.
model EmailDraft {
  id                 String              @id @default(cuid())
  organisationId     String
  leadId             String
  generationType     EmailGenerationType
  basedOnDraftId     String?
  researchSnapshotId String?
  subject            String
  body               String
  modelUsed          String
  status             EmailDraftStatus    @default(DRAFT)
  createdByUserId    String?

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead             Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  basedOnDraft     EmailDraft?       @relation("EmailDraftDerivations", fields: [basedOnDraftId], references: [id])
  derivedDrafts    EmailDraft[]      @relation("EmailDraftDerivations")
  researchSnapshot ResearchSnapshot? @relation(fields: [researchSnapshotId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([leadId])
  @@index([basedOnDraftId])
}

enum InboxProvider {
  GOOGLE
}

enum InboxStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
  ERROR
}

/// A connected Gmail sending mailbox (Phase 6). Distinct from Account (Auth.js
/// login) — this uses its own OAuth client/scopes and its own encrypted
/// token storage, per the spec's requirement that login and sending
/// credentials never share a token. Tokens are encrypted at rest with
/// TOKEN_ENCRYPTION_KEY (see packages/gmail/src/token-crypto.ts); only that
/// package ever decrypts them.
model Inbox {
  id                    String        @id @default(cuid())
  organisationId        String
  emailAddress          String
  displayName           String?
  provider              InboxProvider @default(GOOGLE)
  status                InboxStatus   @default(CONNECTED)
  dailySendLimit        Int           @default(30)
  /// Set when this inbox reserves its next send slot, to the moment it may
  /// send again (last claim + the campaign's inboxCooldownMinutes). Lives on
  /// the inbox rather than the campaign because the throttle protects the
  /// INBOX's reputation — an inbox in two campaigns is still one mailbox —
  /// and because a conditional UPDATE on this column is what makes the
  /// claim atomic across concurrent outbox workers. Null means never sent.
  sendCooldownUntil     DateTime?
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiresAt        DateTime
  connectedByUserId     String
  lastSyncedAt          DateTime?
  disconnectedAt        DateTime?

  organisation  Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaigns     CampaignInbox[]
  outboxItems   OutboxItem[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, emailAddress])
  @@index([organisationId])
}

/// A reusable signature block shared across every inbox in an organisation.
/// Multiple signatures per organisation are allowed (e.g. different
/// roles/styles); at most one is marked isDefault at a time (enforced by
/// signature-service.ts's setDefaultSignature, not the database) — that's
/// the one appended to every AI-generated email, regardless of which inbox
/// sends it. content is plain text, appended verbatim after the AI's body
/// by applySignature in packages/email-generation/src/generate.ts.
model Signature {
  id             String  @id @default(cuid())
  organisationId String
  label          String
  content        String
  isDefault      Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
}

enum DnsCheckStatus {
  PASS
  FAIL
  MISSING
  UNKNOWN
}

/// Deterministic SPF/DKIM/DMARC deliverability check for a sending domain
/// (Phase 6). Domain-level, not per-inbox — multiple inboxes on the same
/// domain share one record. DKIM requires a selector (Google Workspace
/// selectors aren't guessable/fixed), so dkimStatus stays UNKNOWN until one
/// is supplied.
model DomainDnsCheck {
  id           String         @id @default(cuid())
  organisationId String
  domain       String
  spfStatus    DnsCheckStatus @default(UNKNOWN)
  spfRecord    String?
  dkimSelector String?
  dkimStatus   DnsCheckStatus @default(UNKNOWN)
  dkimRecord   String?
  dmarcStatus  DnsCheckStatus @default(UNKNOWN)
  dmarcRecord  String?
  checkedAt    DateTime       @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, domain])
  @@index([organisationId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// A campaign is a sequence of steps sent to enrolled leads from a pool of
/// inboxes (Phase 7 builds the definition; Phase 8 executes it). Sending
/// days/window are stored per-campaign in the campaign's own timezone —
/// the scheduler (Phase 8) is responsible for converting to each send's
/// actual wall-clock time.
model Campaign {
  id                       String         @id @default(cuid())
  organisationId           String
  name                     String
  description              String?
  status                   CampaignStatus @default(DRAFT)
  timezone                 String         @default("UTC")
  /// 0 (Sunday) - 6 (Saturday).
  sendingDaysOfWeek        Int[]          @default([1, 2, 3, 4, 5])
  sendingWindowStartMinute Int            @default(540)
  sendingWindowEndMinute   Int            @default(1020)
  /// Minimum gap between two sends from the SAME inbox, for inbox health —
  /// without it a whole batch of due items leaves one mailbox in seconds,
  /// which is what spam filters look for. Enforced per inbox, so a pool of
  /// N inboxes still sends N emails concurrently. 0 disables the throttle.
  inboxCooldownMinutes     Int            @default(3)
  /// Tone/style guidance for AI-generated copy in THIS campaign. When set it
  /// replaces Organisation.emailPromptInstructions outright (it does not
  /// stack with it) so a campaign's voice is readable in one place; null/empty
  /// falls back to the organisation-level instructions. Like the org-level
  /// field this is style guidance only — the hard rules in the generation
  /// system prompt always take priority (see packages/email-generation/src/prompt.ts).
  emailPromptInstructions  String?
  createdByUserId          String

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps        CampaignStep[]
  inboxes      CampaignInbox[]
  enrollments  CampaignEnrollment[]
  outboxItems  OutboxItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([organisationId, status])
}

enum SequenceStepType {
  INITIAL
  FOLLOW_UP
  CLOSE_THE_LOOP
}

/// One step in a campaign's sequence, ordered by orderIndex. Content is
/// either generated via AI at send time (Phase 5's generateEmail, using
/// callToActionOverride if set) or a manually-written template with simple
/// {{firstName}}-style merge tokens — never both, per useAiGeneration.
model CampaignStep {
  id                   String           @id @default(cuid())
  campaignId           String
  orderIndex           Int
  stepType             SequenceStepType
  /// Days after the previous step (0 for the first step).
  delayDays            Int              @default(0)
  useAiGeneration      Boolean          @default(true)
  callToActionOverride String?
  manualSubject        String?
  manualBody           String?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outboxItems OutboxItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, orderIndex])
  @@index([campaignId])
}

/// The rotation pool of sending inboxes for a campaign (Phase 8 rotates
/// sends across these). Many-to-many: one inbox can serve multiple
/// campaigns, one campaign can use multiple inboxes.
model CampaignInbox {
  id         String @id @default(cuid())
  campaignId String
  inboxId    String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inbox    Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, inboxId])
  @@index([campaignId])
}

enum CampaignEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  EXITED
  SUPPRESSED
}

/// A lead's participation in a campaign. currentStepIndex tracks progress
/// through Campaign.steps (Phase 8 advances it on send); a lead already
/// suppressed at enrollment time is enrolled with status SUPPRESSED rather
/// than silently skipped, so it's visible in the UI why they're not being
/// contacted.
model CampaignEnrollment {
  id               String                   @id @default(cuid())
  campaignId       String
  leadId           String
  status           CampaignEnrollmentStatus @default(PENDING)
  currentStepIndex Int                      @default(0)
  /// When the most recent step's email was actually sent — the anchor
  /// enrollment-progression.ts's delay math counts forward from, not
  /// enrolledAt (which never changes).
  lastStepSentAt   DateTime?
  exitReason       String?

  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  outboxItems OutboxItem[]

  enrolledAt DateTime  @default(now())
  exitedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
}

enum OutboxItemStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  SKIPPED_SUPPRESSED
  CANCELLED
}

/// One scheduled/sent email for one enrollment's step. The unique
/// constraint on (campaignId, leadId, campaignStepId) is the idempotency
/// guarantee — the scheduler can be re-run any number of times without
/// ever creating a duplicate send for the same lead+step. Content is
/// materialized (subject/body populated) once, at send time, and never
/// regenerated on retry, so a retried send is byte-identical to the first
/// attempt.
model OutboxItem {
  id             String           @id @default(cuid())
  organisationId String
  campaignId     String
  leadId         String
  campaignStepId String
  enrollmentId   String
  status         OutboxItemStatus @default(SCHEDULED)
  scheduledFor   DateTime
  inboxId        String?
  subject        String?
  body           String?
  attempts       Int              @default(0)
  lastError      String?
  sentAt         DateTime?
  providerMessageId String?
  providerThreadId  String?

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignStep CampaignStep       @relation(fields: [campaignStepId], references: [id], onDelete: Cascade)
  enrollment   CampaignEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  inbox        Inbox?             @relation(fields: [inboxId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, leadId, campaignStepId])
  @@index([organisationId])
  @@index([status, scheduledFor])
  @@index([inboxId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// One email thread with a lead, scoped to the inbox it lives in (Phase 9).
/// Deliberately keyed by (organisationId, leadId, inboxId) rather than
/// per-campaign — a reply from a lead pauses ALL of that lead's automated
/// sequences across every campaign, not just the one that triggered it, per
/// the product's human-safety principle that a reply always hands control
/// to a person.
model Conversation {
  id             String             @id @default(cuid())
  organisationId String
  leadId         String
  inboxId        String
  gmailThreadId  String
  subject        String?
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime           @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  inbox        Inbox                 @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, leadId, inboxId])
  @@index([organisationId])
  @@index([leadId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// Deliberately NOT AI-classified — see packages/conversations'
/// reply-classifier.ts. Deterministic keyword rules only, per the spec's
/// AI usage boundary (reply classification is explicitly listed as a
/// forbidden AI use case).
enum ReplyClassification {
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  UNSUBSCRIBE_REQUEST
  BOUNCE
  UNCLASSIFIED
}

model ConversationMessage {
  id              String            @id @default(cuid())
  conversationId  String
  direction       MessageDirection
  gmailMessageId  String?
  outboxItemId    String?
  classification  ReplyClassification?
  snippet         String?
  occurredAt      DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, gmailMessageId])
  @@index([conversationId])
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

/// A booked meeting, logged by a human (no calendar integration exists —
/// this is a manual record, typically created from a Conversation once a
/// reply turns into a booked call). campaignId is captured at booking time
/// for attribution — it snapshots which campaign's outreach led to this
/// meeting, since the lead's campaign membership can change later.
/// `qualified` is the human judgment call that feeds the product's primary
/// metric (qualified meeting rate = qualified meetings / unique prospects
/// contacted) — never inferred automatically.
model Meeting {
  id              String        @id @default(cuid())
  organisationId  String
  leadId          String
  campaignId      String?
  conversationId  String?
  status          MeetingStatus @default(SCHEDULED)
  qualified       Boolean       @default(false)
  scheduledFor    DateTime?
  notes           String?
  createdByUserId String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  bookedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([leadId])
  @@index([campaignId])
}
