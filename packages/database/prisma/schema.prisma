// Mail Orbyt database schema.
//
// This file grows one phase at a time. Phase 0 established the toolchain;
// Phase 2 adds authentication, multi-tenancy, invitations, and audit
// logging.
//
// Full model list target (see docs/architecture.md): User, Account, Session,
// VerificationToken, Organisation, OrganisationMembership, Invitation,
// AuditEvent, Lead, Company, LeadCompany, LeadList, LeadListMembership,
// ImportBatch, ImportRow, DataSource, ResearchJob, ResearchProviderRun,
// ResearchSource, ResearchDocument, ResearchFact, ResearchFactEvidence,
// ResearchSnapshot, Campaign, CampaignLead, SequenceStep, EmailDraft,
// EmailGeneration, InboxConnection, OAuthCredential, InboxSettings,
// SendingDomain, DomainAuthenticationCheck, ScheduledEmail, OutboxMessage,
// SentEmail, EmailEvent, Conversation, Reply, Meeting, MeetingOutcome,
// AttributionRecord, SuppressionEntry, RetargetTask, JobFailure, FeatureFlag.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Operational kill switches (e.g. organisation-wide emergency sending stop).
/// Introduced in Phase 0 because the architecture test and worker bootstrap
/// both need a real table to prove migrations work end-to-end.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ---------------------------------------------------------------------------
// Authentication (Auth.js adapter models + our own credential fields)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null for users who only ever sign in via Google login (no local password).
  passwordHash  String?
  /// Bumped whenever the password changes. Sessions use JWT (required
  /// because the Credentials provider cannot use adapter-persisted database
  /// sessions), so this is how a password reset forces existing sessions to
  /// be treated as invalid — the JWT callback compares its embedded value
  /// against this column on every request.
  passwordChangedAt DateTime?

  accounts               Account[]
  sessions               Session[]
  memberships            OrganisationMembership[]
  sentInvitations        Invitation[]              @relation("InvitedBy")
  auditEvents            AuditEvent[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Auth.js adapter model — one row per linked OAuth provider (Google login).
/// Distinct from Gmail sending credentials (packages/gmail, Phase 6): this
/// table is ONLY ever used for application sign-in tokens.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by Auth.js's PrismaAdapter type contract even though this
/// product uses Credentials + Google OAuth (no email magic-link provider).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organisation {
  id   String @id @default(cuid())
  name String
  slug String @unique

  memberships OrganisationMembership[]
  invitations Invitation[]
  auditEvents AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id              String           @id @default(cuid())
  organisationId  String
  email           String
  role            OrganisationRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

enum AuditEventType {
  LOGIN
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
  ORGANISATION_CREATED
  INBOX_CONNECTED
  CAMPAIGN_LAUNCHED
  CAMPAIGN_PAUSED
  SUPPRESSION_CREATED
  DATA_EXPORTED
  DATA_DELETED
}

model AuditEvent {
  id             String   @id @default(cuid())
  organisationId String?
  userId         String?
  type           AuditEventType
  /// Non-sensitive structured context only (e.g. { targetUserId, role }).
  /// Never store tokens, passwords, or full email content here.
  metadata       Json?

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
