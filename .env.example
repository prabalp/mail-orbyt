# Copy to .env and fill in local values. See docs/environment-variables.md
# for a full description of every variable and where to obtain it.

NODE_ENV=development

APP_URL=http://localhost:3000
APP_NAME="Mail Orbyt"

DATABASE_URL=postgresql://mail_orbyt:mail_orbyt@localhost:5432/mail_orbyt
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth client used for application sign-in (Google login button).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Separate Google OAuth client used ONLY for connecting Gmail sending
# inboxes. Never reuse the login client's credentials or tokens for sending.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# AES-256-GCM key (base64, 32 bytes) used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Local S3-compatible storage (MinIO via docker-compose). Point at a real
# bucket in production.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=mail-orbyt
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# AI provider (Google Gemini API) — used exclusively by
# packages/email-generation (Phase 5). Get a key at
# https://aistudio.google.com/apikey
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=600

# External research providers — optional; research falls back to
# website/RSS/JSON-LD extraction when unset (Phase 4).
SEARCH_PROVIDER_API_KEY=
NEWS_PROVIDER_API_KEY=
ENRICHMENT_PROVIDER_API_KEY=

# Keyword extraction mode (packages/research-keywords): "deterministic"
# (default, no AI) or "ai" (uses AI_PROVIDER_API_KEY above, opt-in only —
# see docs/ai-boundaries.md). Either way, extraction reads the page text
# already saved by research and never re-fetches the website.
KEYWORD_EXTRACTION_MODE=deterministic

# Journey routing decider (optional): an OpenRouter key enables Jev to choose a
# journey's next email from a lead's reply. Unset = keyword rules only.
JOURNEY_DECIDER_API_KEY=
# JOURNEY_DECIDER_MODEL=typesafe/jev-1.14
# JOURNEY_DECIDER_MIN_CONFIDENCE=0.6

# Transactional email provider (Resend) for verification, password reset,
# and invitation emails. Get a key at https://resend.com/api-keys. Leave
# unset to log emails to the console instead of sending them (local dev).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Organisation-wide emergency stop for all outbound sending.
EMERGENCY_STOP=false
LOG_LEVEL=info

# Open-tracking pixel (packages/tracking): the stable hostname organisations
# CNAME their own tracking subdomain to (this app's reverse proxy — see
# infra/Caddyfile.example), and a shared secret the proxy sends when asking
# whether to issue TLS for an incoming hostname. Leave both unset to disable
# the feature (the Settings > Tracking page won't let orgs verify a domain).
TRACKING_CNAME_TARGET=
INTERNAL_ASK_SECRET=

# Remote MCP connector (apps/mcp-server) — lets Claude perform the same
# actions as the web UI, authenticated via an OAuth 2.1 flow served by
# apps/web. Defaults are sensible for local dev.
MCP_SERVER_PORT=3001
MCP_ACCESS_TOKEN_TTL_MINUTES=60
MCP_REFRESH_TOKEN_TTL_DAYS=90
# Leave unset to default to APP_URL (same-origin deployment).
MCP_SERVER_URL=

# Social platforms (packages/social-platforms) — OAuth apps for connecting
# organisation social accounts to post/reply and monitor mentions. Each
# platform is independently optional; leave a platform's vars unset to
# disable connecting that platform.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=

TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_REDIRECT_URI=

REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=
REDDIT_OAUTH_REDIRECT_URI=
REDDIT_USER_AGENT=

META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# Orbyt MCP gateway (see the mcp_gateway_orbyt repo): its RFC 8707 resource URI.
# After setting, run `pnpm --filter @mail-orbyt/mcp-oauth run seed-mcp-resources`
# to register it, and mint the gateway's/lead_orbyt's introspection clients with
# `pnpm --filter @mail-orbyt/mcp-oauth run create-introspection-client -- "<name>"`.
GATEWAY_RESOURCE_URI=
