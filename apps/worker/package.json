{
  "name": "@mail-orbyt/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --ignore \"**/node_modules/**\" --ignore \"**/.git/**\" --ignore \"**/.turbo/**\" --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mail-orbyt/ai-settings": "workspace:*",
    "@mail-orbyt/config": "workspace:*",
    "@mail-orbyt/conversations": "workspace:*",
    "@mail-orbyt/database": "workspace:*",
    "@mail-orbyt/email-generation": "workspace:*",
    "@mail-orbyt/gmail": "workspace:*",
    "@mail-orbyt/leads": "workspace:*",
    "@mail-orbyt/logging": "workspace:*",
    "@mail-orbyt/research": "workspace:*",
    "@mail-orbyt/research-keywords": "workspace:*",
    "@mail-orbyt/scheduling": "workspace:*",
    "@mail-orbyt/social-generation": "workspace:*",
    "@mail-orbyt/social-platforms": "workspace:*",
    "@mail-orbyt/social-policy": "workspace:*",
    "@mail-orbyt/social-scheduling": "workspace:*",
    "@mail-orbyt/storage": "workspace:*",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
